  },
  "call": {
    "entry": "infer_multi",
    "signature_used": "model.infer_multi(tokenizer, prompt=PROMPT, image_files=[PIL RGB pages in order], **fixed_kwargs, max_new_tokens=..., ngram_window=...)",
    "prompt": "Multi page parsing.",
    "prompt_expansion": "native infer(): '<PAGE><image>' * n_pages + prompt (no <image> placeholder in PROMPT)",
    "page_token_id": 128827,
    "fixed_kwargs": {
      "crop_mode": false,
      "save_results": false,
      "output_path": "",
      "temperature": 0.0,

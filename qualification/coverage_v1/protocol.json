    "per_fixture_kwargs": [
      "max_new_tokens",
      "ngram_window"
    ],
    "tokens_per_page": 8000,
    "rules": {
      "max_new_tokens": "8000 * page_count (upstream tokens_per_page); the accepted min(8000 * page_count, max_length - prompt_len) equals this whenever prompt_len + 8000 * page_count <= max_length, which is verified from native prompt_token_ids after every call; otherwise CONTEXT_BUDGET_EXCEEDED (failed, never truncated)",
      "ngram_window": "1024 if page_count > 1 else 128 (upstream README evaluation setup), no whitelist",
      "eval_mode": "explicit native default False: native TextStreamer stays on (stdout captured, bounded); unrelated to the eval() save path",
      "stop": "native only: EOS -> finish_reason 'stop'; max_new_tokens or max_length -> 'length' (TRUNCATION failure); native PageCountGuard forces <PAGE>/EOS"
    }

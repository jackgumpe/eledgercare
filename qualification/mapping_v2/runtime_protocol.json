    "load": {
      "trust_remote_code": true,
      "use_safetensors": true,
      "local_files_only": true,
      "then": [
        "eval",
        "cuda"
      ]
    },
    "custom_code_policy": "byte-for-byte; 18 runtime objects verified before load (16 git blob SHA-1, 2 LFS SHA-256, sizes) and after load (module-cache copies identical); model card README.md is a separately verified notice outside the runtime directory"
  },
  "renderer": {
    "distribution": "pypdfium2",
    "version": "5.15.2",
    "pdfium_version": "159.0.8149.0",
    "call": "pypdfium2.PdfDocument(verified_bytes)[i].render(scale=300.0 / 72.0).to_pil().convert('RGB')",
    "scale_numerator": 300.0,
    "scale_denominator": 72.0,
    "input": "verified_pdf_bytes",
    "model_input": "the rendered PIL RGB images are passed to infer_multi directly (no intermediate image file)"
  },
  "call": {
    "entry": "infer_multi",
    "signature_used": "model.infer_multi(tokenizer, prompt=PROMPT, image_files=[PIL RGB pages in order], **fixed_kwargs, max_new_tokens=..., ngram_window=...)",
    "prompt": "Multi page parsing.",
    "prompt_expansion": "native infer(): '<PAGE><image>' * n_pages + prompt (no <image> placeholder in PROMPT)",
    "page_token_id": 128827,
    "fixed_kwargs": {
      "crop_mode": false,
      "save_results": false,
      "output_path": "",
      "temperature": 0.0,
      "max_length": 131072,
      "max_page_tokens": 20000,
      "page_count_guard": true,
      "image_size": 640,
      "base_size": 1024,
      "max_crops": 16,
      "no_repeat_ngram_size": 35,
      "ngram_whitelist_token_ids": null,
      "dash_topm": 16,
      "tps_interval": 0,
      "test_compress": false,
      "eval_mode": false
    },
    "per_fixture_kwargs": [
      "max_new_tokens",
      "ngram_window"
    ],
    "tokens_per_page": 8000,
    "rules": {
      "max_new_tokens": "8000 * page_count (upstream tokens_per_page); the accepted min(8000 * page_count, max_length - prompt_len) equals this whenever prompt_len + 8000 * page_count <= max_length, which is verified from native prompt_token_ids after every call; otherwise CONTEXT_BUDGET_EXCEEDED (failed, never truncated)",
      "ngram_window": "1024 if page_count > 1 else 128 (upstream README evaluation setup), no whitelist",
      "eval_mode": "explicit native default False: native TextStreamer stays on (stdout captured, bounded); unrelated to the eval() save path",
      "stop": "native only: EOS -> finish_reason 'stop'; max_new_tokens or max_length -> 'length' (TRUNCATION failure); native PageCountGuard forces <PAGE>/EOS"
    }
  },
  "guards": {
    "timeouts_s": {
      "preflight": 1800,
      "load": 1800,
      "call_pages_1": 1800,
      "call_pages_3": 3600,
      "session": 21600
    },
    "stall_s": 300,
    "heartbeat_interval_s": 5,
    "max_log_bytes": 67108864,
    "max_raw_output_bytes": 16777216,
    "basis": "Harness policy, not measured performance. Phase timeouts bound the run; stall = no native model-forward return for stall_s inside a call (suspected WDDM paging stall). Revisit only through review, never mid-run."
  },

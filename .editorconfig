root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,ts,html,css,scss,mjs,cjs,js}]
indent_size = 2

[*.{csproj,props,targets,slnx,config,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
csharp_prefer_braces = true:suggestion
# Migrations are generated by the pinned dotnet-ef tool.
[src/ELedgerCare.Infrastructure/Persistence/Migrations/*.cs]
generated_code = true

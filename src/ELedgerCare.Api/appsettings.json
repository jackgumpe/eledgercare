{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Api": {
    "Port": 5590
  },
  "Intake": {
    "MaxDocumentBytes": 10485760,
    "MaxPages": 50
  },
  "LocalOcr": {
    "Enabled": false,
    "MaxExtractionPages": 3,
    "ReadOnlyQ0Root": "",
    "WritableRuntimeRoot": "",
    "LeasedGpuUuid": "",
    "WorkerRootPath": ""
  }
}

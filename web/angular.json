{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false,
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "eledgercare-web": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "elc",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "index": "src/index.html",
            "styles": ["src/styles.css"],
            "outputPath": "dist/eledgercare-web"
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [
                { "type": "initial", "maximumWarning": "500kB", "maximumError": "1MB" }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "host": "127.0.0.1",
            "port": 4210,
            "proxyConfig": "proxy.conf.mjs"
          },
          "configurations": {
            "production": { "buildTarget": "eledgercare-web:build:production" },
            "development": { "buildTarget": "eledgercare-web:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}

<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Keep restored packages inside this ignored worktree directory instead of a user-wide cache. -->
    <add key="globalPackagesFolder" value=".local/nuget/packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

+                "demo_root_bytes": total, "demo_drive_free_bytes": free,
+                "storage_cap_bytes": STORAGE_CAP_BYTES, "free_floor_bytes": MIN_FREE_DISK_BYTES}
+    if total > STORAGE_CAP_BYTES or free < MIN_FREE_DISK_BYTES:
+        raise ReviewerLeaseGuardError(f"Demo disk/storage bounds failed: bytes={total}, free={free}")
+    return observed
+

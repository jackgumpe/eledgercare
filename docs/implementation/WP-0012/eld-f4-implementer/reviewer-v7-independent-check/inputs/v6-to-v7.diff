+def measure_owned_demo_storage(root: Path) -> dict:
+    """Measure current owned-root bytes and actual volume free space, failing closed."""
+    if not root.is_dir() or is_reparse_or_link(root):
+        raise ReviewerLeaseGuardError("Owned demo root is missing or linked")
+    total, files = 0, 0
+    def fail_walk(error):
+        raise ReviewerLeaseGuardError("Owned demo tree enumeration failed") from error
+    for directory, dirnames, filenames in os.walk(root, followlinks=False, onerror=fail_walk):
+        for name in dirnames + filenames:
+            path = Path(directory) / name
+            if is_reparse_or_link(path):
+                raise ReviewerLeaseGuardError("Owned demo tree contains a linked entry")
+        for name in filenames:
+            path = Path(directory) / name
+            if not path.is_file():
+                raise ReviewerLeaseGuardError("Owned demo tree contains a non-file entry")
+            total += path.stat().st_size
+            files += 1
+    free = shutil.disk_usage(root).free
+    if type(free) is not int or free < 0:
+        raise ReviewerLeaseGuardError("Owned demo free-space observation is malformed")
+    observed = {"schema": "eledgercare.wp0012.owned-demo-storage/1",
